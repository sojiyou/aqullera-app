<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@color/midnight_blue">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_arrow"
            android:background="@null"
            android:contentDescription="Back"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order Confirmation"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Receipt Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="20dp"
                android:elevation="2dp">

                <!-- Receipt Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingBottom="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bottom_dashed_divider">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AQUA-LLERA"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order Receipt"
                        android:textSize="11sp"
                        android:textColor="#999999"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvStationName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Station Name"
                        android:textSize="13sp"
                        android:textColor="#666666"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tvReferenceNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ref: Generating..."
                        android:textSize="10sp"
                        android:textColor="#999999"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvOrderTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivery"
                        android:textSize="10sp"
                        android:textColor="@color/midnight_blue"
                        android:background="@drawable/badge_bg"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="3dp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Column Headers -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bottom_dashed_divider">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="ITEM"
                        android:textSize="10sp"
                        android:textColor="#999999"
                        android:textStyle="bold"
                        android:textAllCaps="true" />

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="QTY"
                        android:textSize="10sp"
                        android:textColor="#999999"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textAllCaps="true" />

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="AMOUNT"
                        android:textSize="10sp"
                        android:textColor="#999999"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:textAllCaps="true" />
                </LinearLayout>

                <!-- Pure Water Item -->
                <LinearLayout
                    android:id="@+id/layoutPureWater"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvPureWaterName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Pure Water"
                        android:textSize="12sp"
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/tvPureWaterQty"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvPureWaterAmount"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="₱0.00"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Spring Water Item -->
                <LinearLayout
                    android:id="@+id/layoutSpringWater"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSpringWaterName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Spring Water"
                        android:textSize="12sp"
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/tvSpringWaterQty"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvSpringWaterAmount"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="₱0.00"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Mineral Water Item -->
                <LinearLayout
                    android:id="@+id/layoutMineralWater"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvMineralWaterName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Mineral Water"
                        android:textSize="12sp"
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/tvMineralWaterQty"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvMineralWaterAmount"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="₱0.00"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Dashed Divider after items -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/bottom_dashed_divider"
                    android:layout_marginVertical="12dp" />

                <!-- Fee Breakdown -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bottom_dashed_divider">

                    <!-- Subtotal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subtotal"
                            android:textSize="12sp"
                            android:textColor="#666666" />

                        <TextView
                            android:id="@+id/tvSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textSize="12sp"
                            android:textColor="#333333" />
                    </LinearLayout>

                    <!-- Delivery Fee -->
                    <LinearLayout
                        android:id="@+id/layoutDeliveryFee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Delivery Fee"
                            android:textSize="12sp"
                            android:textColor="#666666" />

                        <TextView
                            android:id="@+id/tvDeliveryFee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textSize="12sp"
                            android:textColor="#333333" />
                    </LinearLayout>

                    <!-- Transaction Fee -->
                    <LinearLayout
                        android:id="@+id/layoutTransactionFee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Transaction Fee (2%)"
                            android:textSize="12sp"
                            android:textColor="#666666" />

                        <TextView
                            android:id="@+id/tvTransactionFee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textSize="12sp"
                            android:textColor="#333333" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Grand Total -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bottom_dashed_divider">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <TextView
                        android:id="@+id/tvGrandTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱0.00"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />
                </LinearLayout>

                <!-- Customer Details -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Customer Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Customer"
                            android:textSize="10sp"
                            android:textColor="#999999" />

                        <TextView
                            android:id="@+id/tvCustomerName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Name"
                            android:textSize="10sp"
                            android:textColor="#666666"
                            android:gravity="end"
                            android:maxWidth="60%" />
                    </LinearLayout>

                    <!-- Contact -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contact"
                            android:textSize="10sp"
                            android:textColor="#999999" />

                        <TextView
                            android:id="@+id/tvCustomerPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            android:textSize="10sp"
                            android:textColor="#666666"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- Address (conditional) -->
                    <LinearLayout
                        android:id="@+id/layoutAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Address"
                            android:textSize="10sp"
                            android:textColor="#999999" />

                        <TextView
                            android:id="@+id/tvDeliveryAddress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            android:textSize="10sp"
                            android:textColor="#666666"
                            android:gravity="end"
                            android:maxWidth="60%" />
                    </LinearLayout>

                    <!-- Date -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Date"
                            android:textSize="10sp"
                            android:textColor="#999999" />

                        <TextView
                            android:id="@+id/tvOrderDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            android:textSize="10sp"
                            android:textColor="#666666"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- Time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Time"
                            android:textSize="10sp"
                            android:textColor="#999999" />

                        <TextView
                            android:id="@+id/tvOrderTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            android:textSize="10sp"
                            android:textColor="#666666"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- Notes (conditional) -->
                    <LinearLayout
                        android:id="@+id/layoutNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notes"
                            android:textSize="10sp"
                            android:textColor="#999999" />

                        <TextView
                            android:id="@+id/tvAdditionalDetails"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            android:textSize="10sp"
                            android:textColor="#666666"
                            android:gravity="end"
                            android:maxWidth="60%" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnEditOrder"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Edit Order"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/midnight_blue"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnConfirmOrder"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Confirm Order"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary"
                    android:textColor="@color/white"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thank you for ordering! Your order will be processed shortly."
                android:textSize="12sp"
                android:textColor="#999999"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="20dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
