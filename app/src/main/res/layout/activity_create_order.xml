<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@color/midnight_blue">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_arrow"
            android:background="@null"
            android:contentDescription="Back"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Order"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Content Area (Form / Preview) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ==================== FORM ==================== -->
        <ScrollView
            android:id="@+id/formContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Station Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏪 Station"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <TextView
                        android:id="@+id/tvWaterStationName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Station Name"
                        android:textSize="13sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Email Verification Warning -->
                <LinearLayout
                    android:id="@+id/emailWarningCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start|center_vertical"
                    android:background="@drawable/amber_warning_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️"
                        android:textSize="18sp"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email not verified"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#92400E" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Please verify your email to place orders."
                            android:textSize="11sp"
                            android:textColor="#A16207"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/btnResendVerification"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resend verification email"
                            android:textSize="11sp"
                            android:textColor="#92400E"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Quantities Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💧 Select Quantities"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <!-- Pure Water -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="pure"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/midnight_blue" />

                            <TextView
                                android:id="@+id/tvPureWaterPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱0.00 / gallon"
                                android:textSize="11sp"
                                android:textColor="#999999" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <Button
                                android:id="@+id/btnDecreaseGallonPure"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:text="-"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/midnight_blue"
                                android:background="@drawable/gray_circle_bg"
                                android:gravity="center"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp" />

                            <EditText
                                android:id="@+id/etGallonPure"
                                android:layout_width="48dp"
                                android:layout_height="36dp"
                                android:layout_marginHorizontal="8dp"
                                android:background="@drawable/gray_input_field_bg"
                                android:inputType="number"
                                android:text="0"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/midnight_blue"
                                android:gravity="center"
                                android:maxLines="1"
                                android:maxLength="2" />

                            <Button
                                android:id="@+id/btnIncreaseGallonPure"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:text="+"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/midnight_blue"
                                android:background="@drawable/gray_circle_bg"
                                android:gravity="center"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Spring Water -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="spring"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/midnight_blue" />

                            <TextView
                                android:id="@+id/tvSpringWaterPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱0.00 / liter"
                                android:textSize="11sp"
                                android:textColor="#999999" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <Button
                                android:id="@+id/btnDecreaseLiterSpring"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:text="-"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/midnight_blue"
                                android:background="@drawable/gray_circle_bg"
                                android:gravity="center"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp" />

                            <EditText
                                android:id="@+id/etLiterSpring"
                                android:layout_width="48dp"
                                android:layout_height="36dp"
                                android:layout_marginHorizontal="8dp"
                                android:background="@drawable/gray_input_field_bg"
                                android:inputType="number"
                                android:text="0"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/midnight_blue"
                                android:gravity="center"
                                android:maxLines="1"
                                android:maxLength="2" />

                            <Button
                                android:id="@+id/btnIncreaseLiterSpring"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:text="+"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/midnight_blue"
                                android:background="@drawable/gray_circle_bg"
                                android:gravity="center"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Mineral Water -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="mineral"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/midnight_blue" />

                            <TextView
                                android:id="@+id/tvMineralWaterPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱0.00 / gallon"
                                android:textSize="11sp"
                                android:textColor="#999999" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <Button
                                android:id="@+id/btnDecreaseGallonMineral"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:text="-"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/midnight_blue"
                                android:background="@drawable/gray_circle_bg"
                                android:gravity="center"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp" />

                            <EditText
                                android:id="@+id/etGallonMineral"
                                android:layout_width="48dp"
                                android:layout_height="36dp"
                                android:layout_marginHorizontal="8dp"
                                android:background="@drawable/gray_input_field_bg"
                                android:inputType="number"
                                android:text="0"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/midnight_blue"
                                android:gravity="center"
                                android:maxLines="1"
                                android:maxLength="2" />

                            <Button
                                android:id="@+id/btnIncreaseGallonMineral"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:text="+"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/midnight_blue"
                                android:background="@drawable/gray_circle_bg"
                                android:gravity="center"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Order Type Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚚 Order Type"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btnDelivery"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Delivery"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/toggle_btn_active"
                            android:textColor="@color/white"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnPickup"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Pickup"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/toggle_btn_inactive"
                            android:textColor="#666666"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Delivery Address Card -->
                <LinearLayout
                    android:id="@+id/addressCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Delivery Address"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <EditText
                            android:id="@+id/etAddressSearch"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/gray_input_field_bg"
                            android:hint="Type your address or use GPS..."
                            android:textSize="12sp"
                            android:paddingStart="12dp"
                            android:paddingEnd="44dp"
                            android:maxLines="1"
                            android:inputType="text" />

                        <ImageButton
                            android:id="@+id/btnClearAddress"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_clear"
                            android:background="@null"
                            android:visibility="gone"
                            android:contentDescription="Clear" />
                    </RelativeLayout>

                    <!-- Suggestions dropdown -->
                    <LinearLayout
                        android:id="@+id/suggestionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_bg"
                        android:elevation="4dp"
                        android:visibility="gone"
                        android:layout_marginTop="2dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/tvSelectedAddress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="11sp"
                            android:textColor="#666666"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/btnGetLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="📍"
                            android:textSize="14sp"
                            android:background="@drawable/btn_primary"
                            android:textColor="@color/white"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSearchStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="#999999"
                        android:visibility="gone"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Date Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 Preferred Date"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <EditText
                        android:id="@+id/tvSelectedDate"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/gray_input_field_bg"
                        android:text="Select date"
                        android:textSize="12sp"
                        android:textColor="@color/midnight_blue"
                        android:padding="10dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false" />
                </LinearLayout>

                <!-- Time Slots Card -->
                <LinearLayout
                    android:id="@+id/timeSlotsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚚 Delivery Time"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select a delivery time slot"
                        android:textSize="11sp"
                        android:textColor="#999999"
                        android:layout_marginTop="2dp" />

                    <LinearLayout
                        android:id="@+id/timeSlotsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Additional Details Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝 Additional Details"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <EditText
                        android:id="@+id/additionalDetailsInput"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/gray_input_field_bg"
                        android:hint="e.g., Leave at gate, landmark, etc."
                        android:textSize="12sp"
                        android:inputType="textMultiLine"
                        android:padding="10dp"
                        android:gravity="start|top" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ==================== PREVIEW ==================== -->
        <ScrollView
            android:id="@+id/previewContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Order Summary -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛍️ Order Summary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <TextView
                        android:id="@+id/tvPreviewStation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Station: Station Name"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Items -->
                <LinearLayout
                    android:id="@+id/previewItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 Items"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <TextView
                        android:id="@+id/tvPreviewPure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvPreviewSpring"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/tvPreviewMineral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#666666" />
                </LinearLayout>

                <!-- Order Type -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚚 Order Type"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <TextView
                        android:id="@+id/tvPreviewOrderType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivery"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Delivery Address (conditional) -->
                <LinearLayout
                    android:id="@+id/previewAddressCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Delivery Address"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <TextView
                        android:id="@+id/tvPreviewAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Date & Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 Preferred Schedule"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <TextView
                        android:id="@+id/tvPreviewDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvPreviewTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Instructions (conditional) -->
                <LinearLayout
                    android:id="@+id/previewInstructionsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝 Instructions"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <TextView
                        android:id="@+id/tvPreviewInstructions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Payment Breakdown -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💵 Payment Breakdown"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/midnight_blue" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Subtotal"
                                android:textSize="12sp"
                                android:textColor="#666666" />

                            <TextView
                                android:id="@+id/tvPreviewSubtotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱0.00"
                                android:textSize="12sp"
                                android:textColor="#333333" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/previewDeliveryFeeRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Delivery Fee"
                                android:textSize="12sp"
                                android:textColor="#666666" />

                            <TextView
                                android:id="@+id/tvPreviewDeliveryFee"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱0.00"
                                android:textSize="12sp"
                                android:textColor="#333333" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Transaction Fee (2%)"
                                android:textSize="12sp"
                                android:textColor="#666666" />

                            <TextView
                                android:id="@+id/tvPreviewTransactionFee"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱0.00"
                                android:textSize="12sp"
                                android:textColor="#333333" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E0E0E0"
                            android:layout_marginVertical="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Grand Total"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/midnight_blue" />

                            <TextView
                                android:id="@+id/tvPreviewGrandTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱0.00"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/midnight_blue" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/app_bg">

        <!-- Preview Button (visible when in form mode) -->
        <Button
            android:id="@+id/btnPreviewOrder"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Preview Order"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:textColor="@color/white" />

        <!-- Edit / Proceed Buttons (visible when in preview mode) -->
        <LinearLayout
            android:id="@+id/bottomActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <Button
                android:id="@+id/btnEditOrder"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Edit Order"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/midnight_blue"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnProceed"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Proceed"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/btn_primary"
                android:textColor="@color/white"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
