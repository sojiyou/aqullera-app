<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Avatar + Name + Email -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvAvatarInitial"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:gravity="center"
                    android:textSize="32sp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:background="@drawable/circle_avatar_bg"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User"
                    android:textSize="20sp"
                    android:textColor="@color/midnight_blue"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="email@example.com"
                    android:textSize="14sp"
                    android:textColor="#666666" />

            </LinearLayout>

            <!-- Account Details Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account Details"
                    android:textSize="16sp"
                    android:textColor="@color/midnight_blue"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Name"
                        android:textSize="14sp"
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/tvUserFullName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="N/A"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textSize="14sp"
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/tvUserEmailDetail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="N/A"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone"
                        android:textSize="14sp"
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/tvUserNumber"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="N/A"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Email Verification Card -->
            <LinearLayout
                android:id="@+id/emailVerificationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Verification"
                    android:textSize="16sp"
                    android:textColor="@color/midnight_blue"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Verified banner -->
                <LinearLayout
                    android:id="@+id/verifiedBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/green_verified_bg"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ "
                        android:textSize="16sp"
                        android:textColor="#065F46" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email Verified"
                        android:textSize="14sp"
                        android:textColor="#065F46"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Unverified banner -->
                <LinearLayout
                    android:id="@+id/unverifiedBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/amber_warning_bg"
                    android:padding="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠ "
                            android:textSize="16sp"
                            android:textColor="#92400E" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email not verified"
                            android:textSize="14sp"
                            android:textColor="#92400E"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Verify your email to place orders."
                        android:textSize="12sp"
                        android:textColor="#92400E"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:weightSum="2">

                        <Button
                            android:id="@+id/btnResendVerification"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1.3"
                            android:layout_marginEnd="4dp"
                            android:text="Resend verification email"
                            android:textSize="11sp"
                            android:textColor="@android:color/white"
                            android:background="@drawable/btn_primary"
                            android:gravity="center" />

                        <Button
                            android:id="@+id/btnRefreshStatus"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="0.7"
                            android:layout_marginStart="4dp"
                            android:text="Refresh status"
                            android:textSize="11sp"
                            android:textColor="#333333"
                            android:background="@drawable/status_pending_bg"
                            android:gravity="center" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:weightSum="1"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnEditProfile"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:text="✏ Edit Profile"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/btn_primary"
                    android:gravity="left|center_vertical"
                    android:paddingStart="16dp" />

                <Button
                    android:id="@+id/btnMaps"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:text="🗺 View Maps"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/btn_primary"
                    android:gravity="left|center_vertical"
                    android:paddingStart="16dp" />

                <Button
                    android:id="@+id/btnSeeOrders"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:text="📋 View Orders"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/btn_primary"
                    android:gravity="left|center_vertical"
                    android:paddingStart="16dp" />

                <Button
                    android:id="@+id/btnAbout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:text="ℹ About Aquallera"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/btn_primary"
                    android:gravity="left|center_vertical"
                    android:paddingStart="16dp" />

                <Button
                    android:id="@+id/btnReportBug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Report Bug"
                    android:textAlignment="viewStart"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.AppCompat.Button.Colored"
                    android:backgroundTint="@color/midnight_blue"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/btnLogOut"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🚪 Log Out"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/btn_logout_bg"
                    android:gravity="left|center_vertical"
                    android:paddingStart="16dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <include layout="@layout/bottom_navigation" />

</LinearLayout>
