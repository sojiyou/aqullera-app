<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#ECEFF1"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Top row: Station Name -->
    <TextView
        android:id="@+id/tvStationName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Living Water Refilling Station"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/midnight_blue"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginBottom="6dp" />

    <!-- Status Pill -->
    <TextView
        android:id="@+id/tvOrderStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pending"
        android:textSize="11sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:background="@drawable/status_pending_bg" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/midnight_blue"
        android:layout_marginVertical="8dp" />

    <!-- Date -->
    <TextView
        android:id="@+id/tvOrderDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Date: 2026-04-27"
        android:textSize="13sp"
        android:textColor="@color/midnight_blue" />

    <!-- Ref # -->
    <TextView
        android:id="@+id/tvTicketNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ref #: AQU-20260427-0042"
        android:textSize="13sp"
        android:textColor="@color/midnight_blue" />

    <!-- Items summary -->
    <TextView
        android:id="@+id/tvOrderItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Items: "
        android:textSize="13sp"
        android:textColor="@color/midnight_blue"
        android:layout_marginBottom="4dp" />

    <!-- Grand Total -->
    <TextView
        android:id="@+id/tvOrderPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="₱0.00"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/midnight_blue"
        android:textAlignment="textEnd" />

</LinearLayout>
