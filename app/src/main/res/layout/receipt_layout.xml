<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AQUA-LLERA"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/midnight_blue"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Order Receipt"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Station Name -->
        <TextView
            android:id="@+id/receiptStationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Station Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/midnight_blue" />

        <!-- Reference Number -->
        <TextView
            android:id="@+id/receiptRefNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ref #: AQU-20260427-0042"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <!-- Order Type Badge -->
        <TextView
            android:id="@+id/receiptOrderType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delivery"
            android:textSize="11sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:background="@drawable/midnight_blue_background" />

        <!-- Dashed Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/midnight_blue"
            android:layout_marginVertical="12dp" />

        <!-- Column Headers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Item"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#666666" />

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="Qty"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:gravity="center" />

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Amount"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:gravity="end" />
        </LinearLayout>

        <!-- Pure Water Row -->
        <LinearLayout
            android:id="@+id/receiptPureRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/receiptPureLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Pure Water (Gallon)"
                android:textSize="13sp"
                android:textColor="@color/midnight_blue" />

            <TextView
                android:id="@+id/receiptPureQty"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="13sp"
                android:textColor="@color/midnight_blue"
                android:gravity="center" />

            <TextView
                android:id="@+id/receiptPureAmount"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textSize="13sp"
                android:textColor="@color/midnight_blue"
                android:gravity="end" />
        </LinearLayout>

        <!-- Spring Water Row -->
        <LinearLayout
            android:id="@+id/receiptSpringRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/receiptSpringLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Spring Water (Gallon)"
                android:textSize="13sp"
                android:textColor="@color/midnight_blue" />

            <TextView
                android:id="@+id/receiptSpringQty"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="13sp"
                android:textColor="@color/midnight_blue"
                android:gravity="center" />

            <TextView
                android:id="@+id/receiptSpringAmount"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textSize="13sp"
                android:textColor="@color/midnight_blue"
                android:gravity="end" />
        </LinearLayout>

        <!-- Mineral Water Row -->
        <LinearLayout
            android:id="@+id/receiptMineralRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/receiptMineralLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Mineral Water (Gallon)"
                android:textSize="13sp"
                android:textColor="@color/midnight_blue" />

            <TextView
                android:id="@+id/receiptMineralQty"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="13sp"
                android:textColor="@color/midnight_blue"
                android:gravity="center" />

            <TextView
                android:id="@+id/receiptMineralAmount"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textSize="13sp"
                android:textColor="@color/midnight_blue"
                android:gravity="end" />
        </LinearLayout>

        <!-- Dashed Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/midnight_blue"
            android:layout_marginVertical="8dp" />

        <!-- Subtotal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Subtotal"
                android:textSize="13sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/receiptSubtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textSize="13sp"
                android:textColor="@color/midnight_blue" />
        </LinearLayout>

        <!-- Delivery Fee -->
        <LinearLayout
            android:id="@+id/receiptDeliveryFeeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Delivery Fee"
                android:textSize="13sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/receiptDeliveryFee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textSize="13sp"
                android:textColor="@color/midnight_blue" />
        </LinearLayout>

        <!-- Transaction Fee -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Transaction Fee"
                android:textSize="13sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/receiptTransactionFee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱5.00"
                android:textSize="13sp"
                android:textColor="@color/midnight_blue" />
        </LinearLayout>

        <!-- Dashed Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/midnight_blue"
            android:layout_marginVertical="8dp" />

        <!-- Grand Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Grand Total"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/midnight_blue" />

            <TextView
                android:id="@+id/receiptGrandTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/midnight_blue" />
        </LinearLayout>

        <!-- Dashed Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/midnight_blue"
            android:layout_marginVertical="12dp" />

        <!-- Customer Info Section -->
        <TextView
            android:id="@+id/receiptCustomerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customer: Juan Dela Cruz"
            android:textSize="13sp"
            android:textColor="@color/midnight_blue" />

        <TextView
            android:id="@+id/receiptCustomerPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contact: 09171234567"
            android:textSize="13sp"
            android:textColor="@color/midnight_blue" />

        <TextView
            android:id="@+id/receiptAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Address: 123 Session Rd, Baguio City"
            android:textSize="13sp"
            android:textColor="@color/midnight_blue" />

        <TextView
            android:id="@+id/receiptDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date: 2026-04-27"
            android:textSize="13sp"
            android:textColor="@color/midnight_blue" />

        <TextView
            android:id="@+id/receiptTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time: 2:30 PM"
            android:textSize="13sp"
            android:textColor="@color/midnight_blue" />

        <TextView
            android:id="@+id/receiptNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notes: Leave at gate"
            android:textSize="13sp"
            android:textColor="@color/midnight_blue"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
