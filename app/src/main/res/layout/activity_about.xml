<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Logo -->
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/aqua_llera_logo"
                android:contentDescription="@string/appLogoDesc"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp" />

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="#666666"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp" />

            <!-- What is Aquallera -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/WhatIsAquallera"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#3E5171"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/text_card_background"
                android:padding="12dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/WhatIsAqualleraDesc"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Why make Aquallera -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/whyMakeAquallera"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#3E5171"
                android:gravity="end"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/text_card_background"
                android:padding="12dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/whyMakeAqualleraDesc"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- How to Order -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How to Order"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#3E5171"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/text_card_background"
                android:padding="12dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:lineSpacingExtra="2dp"
                    android:text="1. Select a Water Station on the map.\n2. Click 'Order Now' on your chosen station.\n3. Choose Water Type and Quantity.\n4. Select Pickup or Delivery.\n5. Confirm and Track your order." />
            </LinearLayout>

            <!-- CTA Link -->
            <TextView
                android:id="@+id/tvCtaMaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Let's start Locating Water Stations!"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/midnight_blue"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:foreground="?android:attr/selectableItemBackground" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <include layout="@layout/bottom_navigation" />

</LinearLayout>
