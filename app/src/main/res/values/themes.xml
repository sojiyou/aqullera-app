<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aquallera" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/midnight_blue</item>
        <item name="colorPrimaryDark">@color/midnight_blue_active</item>
        <item name="colorAccent">@color/light_yellow</item>
        <item name="android:fontFamily">@font/nunito</item>
